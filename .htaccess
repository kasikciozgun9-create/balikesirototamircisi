# Balıkesir Oto Tamircisi – Apache / LiteSpeed ayarları
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddType image/avif .avif
AddType text/plain .txt

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS + www'suz tek adres
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://balikesirototamircisi.com.tr/$1 [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# sayfa.html -> /sayfa (kalıcı yönlendirme)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /sayfa -> sayfa.html (içeriden)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(avif|jpg|png|svg|mp4|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml
</IfModule>
